# Application
APP_ENV=development
SERVICE_ROLE=api
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local infrastructure. Use localhost when the API runs directly in WSL.
DATABASE_URL=postgresql+asyncpg://livepilot:change-me@localhost:5432/livepilot
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=change-me
JWT_ISSUER=livepilot-dev
JWT_AUDIENCE=livepilot-web
JWT_CLOCK_SKEW_SECONDS=0
# Docker/Kubernetes mounts take precedence over the corresponding env variable.
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# Realtime provider. Never expose the API key to the frontend.
REALTIME_PROVIDER_BASE_URL=
REALTIME_PROVIDER_API_KEY=change-me
REALTIME_PROVIDER_MODE=mock
# REALTIME_PROVIDER_API_KEY_FILE=/run/secrets/realtime_provider_api_key
REALTIME_MODEL=

# External travel tools
WEATHER_API_KEY=change-me
MAP_API_KEY=change-me
TOOL_PROVIDER_MODE=mock
# WEATHER_API_KEY_FILE=/run/secrets/weather_api_key
# MAP_API_KEY_FILE=/run/secrets/map_api_key

# User-facing resource boundaries
RATE_LIMIT_SESSION_CREATE_PER_MINUTE=10
RATE_LIMIT_SESSION_READ_PER_MINUTE=120
RATE_LIMIT_SESSION_WRITE_PER_MINUTE=30
RATE_LIMIT_WS_CONNECT_PER_MINUTE=20
MAX_API_BODY_BYTES=65536
MAX_JSON_DEPTH=12
MAX_JSON_ITEMS=200

# Observability
OTEL_SERVICE_NAME=livepilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
